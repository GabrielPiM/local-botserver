# Local BotServer (details in README.md)

# Port used in the bot: ws://127.0.0.1:8000/
BOTSERVER_WS_PORT=8000

# 0 = only this PC; 1 = also the local network
BOTSERVER_LAN=0

# Limits
BOTSERVER_WS_MAX_PAYLOAD=65536
BOTSERVER_WS_MAX_PACKETS=100
BOTSERVER_WS_MAX_TOPIC_LENGTH=30

# Ping interval in milliseconds
BOTSERVER_PING_INTERVAL_MS=1000
