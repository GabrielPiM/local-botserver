<!-- Tema PVP3 do DibraBot. So a janela tem fundo; paineis sao apenas borda. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local BotServer" Width="660" Height="520" MinWidth="545" MinHeight="400"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanMinimize" Background="Transparent"
        WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True"
        FontFamily="Verdana" FontSize="11" Foreground="#ffffff">
  <Window.Resources>
    <SolidColorBrush x:Key="Line" Color="#66ffffff"/>
    <SolidColorBrush x:Key="Dim" Color="#88ffffff"/>
    <SolidColorBrush x:Key="Hover" Color="#ff33e0"/>
    <SolidColorBrush x:Key="Selected" Color="#ff00d9"/>

    <Style x:Key="Flat" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="#ffffff"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="B" Background="#01000000" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Hover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Caption" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="#ffffff"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="#01000000" Width="26" Height="22">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Hover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollZone" TargetType="{x:Type RepeatButton}">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RepeatButton}"><Border Background="#01000000"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollZone}" Command="ScrollBar.PageUpCommand"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollZone}" Command="ScrollBar.PageDownCommand"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                      <Border x:Name="T" Background="#66ffffff" Margin="2,0"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="T" Property="Background" Value="{StaticResource Hover}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ListBox}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#ffffff"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBox}">
            <ScrollViewer Focusable="False"><ItemsPresenter/></ScrollViewer>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SelectableRow" TargetType="{x:Type ListBoxItem}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border x:Name="R" Background="#01000000" BorderBrush="Transparent" BorderThickness="1" Padding="7,3">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="R" Property="BorderBrush" Value="{StaticResource Hover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="R" Property="BorderBrush" Value="{StaticResource Selected}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlainRow" TargetType="{x:Type ListBoxItem}">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border Padding="8,4"><ContentPresenter/></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LogRow" TargetType="{x:Type ListBoxItem}">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border Padding="8,1"><ContentPresenter/></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="RoomTemplate">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding Right}" Foreground="{StaticResource Dim}"/>
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="PlayerTemplate">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding Right}" Foreground="#4ade80"/>
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="LogTemplate">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Width="60" Text="{Binding Time}" Foreground="{StaticResource Dim}"/>
        <TextBlock DockPanel.Dock="Left" Width="46" Text="{Binding Tag}" Foreground="{Binding Color}"/>
        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
      </DockPanel>
    </DataTemplate>
  </Window.Resources>

  <Border Background="#d9000000" BorderBrush="#ffffff" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border x:Name="TitleBar" Background="#01000000" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,5,4,5">
        <DockPanel>
          <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource Caption}" Content="X"/>
          <Button x:Name="MinimizeButton" DockPanel.Dock="Right" Style="{StaticResource Caption}" Content="_"/>
          <Image x:Name="TitleIcon" DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,8,0"/>
          <TextBlock Text="Local BotServer" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <DockPanel Grid.Row="1" Margin="8,8,8,0">
        <TextBlock x:Name="Summary" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Dim}"/>
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,7,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock x:Name="UrlText" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Button x:Name="CopyButton" Style="{StaticResource Flat}" Content="Copy"/>
        </StackPanel>
      </DockPanel>

      <Grid Grid.Row="2" Margin="8,8,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,5">
              <DockPanel>
                <TextBlock x:Name="RoomCount" DockPanel.Dock="Right" Foreground="{StaticResource Dim}"/>
                <TextBlock Text="Rooms"/>
              </DockPanel>
            </Border>
            <Grid>
              <TextBlock x:Name="RoomsEmpty" Text="No open rooms" Margin="8,6" TextWrapping="Wrap" Foreground="{StaticResource Dim}"/>
              <ListBox x:Name="RoomList" ItemTemplate="{StaticResource RoomTemplate}" ItemContainerStyle="{StaticResource SelectableRow}"/>
            </Grid>
          </DockPanel>
        </Border>
        <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1">
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,5">
              <DockPanel>
                <TextBlock x:Name="PlayerCount" DockPanel.Dock="Right" Margin="8,0,0,0" Foreground="{StaticResource Dim}"/>
                <TextBlock x:Name="PlayersTitle" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </Border>
            <ListBox x:Name="PlayerList" ItemTemplate="{StaticResource PlayerTemplate}" ItemContainerStyle="{StaticResource PlainRow}"/>
          </DockPanel>
        </Border>
      </Grid>

      <Border Grid.Row="3" Margin="8,8,8,0" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,5">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="last 500 lines" Foreground="{StaticResource Dim}"/>
              <TextBlock Text="Log"/>
            </DockPanel>
          </Border>
          <ListBox x:Name="LogList" FontFamily="Consolas, Lucida Console" ItemTemplate="{StaticResource LogTemplate}" ItemContainerStyle="{StaticResource LogRow}"/>
        </DockPanel>
      </Border>

      <DockPanel Grid.Row="4" Margin="8" LastChildFill="False">
        <Button x:Name="ClearButton" DockPanel.Dock="Left" Style="{StaticResource Flat}" Content="Clear log"/>
        <Button x:Name="FolderButton" DockPanel.Dock="Left" Style="{StaticResource Flat}" Content="Open folder" Margin="8,0,0,0"/>
        <Button x:Name="DiscordButton" DockPanel.Dock="Left" Style="{StaticResource Flat}" Margin="8,0,0,0" AutomationProperties.Name="Discord">
          <StackPanel Orientation="Horizontal">
            <Image x:Name="DiscordIcon" Width="16" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Discord"/>
          </StackPanel>
        </Button>
        <Button x:Name="YouTubeButton" DockPanel.Dock="Left" Style="{StaticResource Flat}" Margin="8,0,0,0" AutomationProperties.Name="YouTube">
          <StackPanel Orientation="Horizontal">
            <Image x:Name="YouTubeIcon" Width="16" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="YouTube"/>
          </StackPanel>
        </Button>
        <Button x:Name="GitHubButton" DockPanel.Dock="Left" Style="{StaticResource Flat}" Margin="8,0,0,0" AutomationProperties.Name="GitHub">
          <StackPanel Orientation="Horizontal">
            <Image x:Name="GitHubIcon" Width="13" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="GitHub"/>
          </StackPanel>
        </Button>
        <Button x:Name="ToggleButton" DockPanel.Dock="Right" Style="{StaticResource Flat}" MinWidth="70"/>
      </DockPanel>
    </Grid>
  </Border>
</Window>
